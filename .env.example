# Resend API key — https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=hello@derrickdigital.ca

# Verified sender. Until the domain is verified in Resend, onboarding@resend.dev works.
CONTACT_FROM_EMAIL=Derrick Digital <onboarding@resend.dev>

# Canonical site origin, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://derrickdigital.ca
